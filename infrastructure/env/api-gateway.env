REDIS_URL=redis://redis:6379

JWT_PUBLIC_KEY_PATH=/app/keys/public.pem
JWT_ISSUER=auth-service
JWT_AUDIENCE=ecommerce-api

OTEL_SERVICE_NAME=api-gateway
